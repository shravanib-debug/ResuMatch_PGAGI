# Copy to .env for local development. Production values go in the host's secrets.
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Local default is SQLite. For Neon, use the direct (non-pooler) host and no query string:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./interview.db

# Comma-separated, no trailing slash
ALLOWED_ORIGINS=http://localhost:3000
